---
import Sidebar from "../components/organisms/Sidebar.astro";
import "../styles/global.css";

interface Props {
  title: string;
  current: "overview" | "keys" | "logs" | "settings";
}
const { title, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8fafc" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f172a" />
    <link rel="icon" href="/admin/favicon.svg" type="image/svg+xml" />
    <title>{title} · Quecto</title>
  </head>
  <body class="m-0">
    <!-- Two columns become two blocks, which also lets the bar at the top of a
         phone stick to the viewport rather than to its grid row. -->
    <div class="grid min-h-screen grid-cols-[240px_1fr] max-md:block">
      <Sidebar current={current} />
      <main class="min-w-0">
        <!-- Centred, so the space past the cap splits evenly rather than
             collecting on the right. -->
        <div class="mx-auto max-w-[1200px] px-8 pt-7 pb-16 max-md:px-4 max-md:pt-5 max-md:pb-10">
          <slot />
        </div>
      </main>
    </div>

    <script>
      import { api } from "../lib/api";

      // Cheaper than the health endpoint, which probes the model server.
      const count = document.getElementById("nav-key-count");
      if (count) {
        api
          .me()
          .then((me) => (count.textContent = String(me.key_count)))
          .catch(() => {});
      }

      // Sign out appears twice, once in the sidebar footer and once beside the
      // brand where a phone can reach it.
      for (const button of document.querySelectorAll("[data-sign-out]")) {
        button.addEventListener("click", async () => {
          await api.logout().catch(() => {});
          window.location.href = "/admin/login";
        });
      }
    </script>
  </body>
</html>
