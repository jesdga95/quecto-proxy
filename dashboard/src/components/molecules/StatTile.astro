---
interface Props {
  label: string;
  id: string;
  footId?: string;
  foot?: string;
  accent?: boolean;
}
const { label, id, footId, foot = "", accent = false } = Astro.props;
---

<div
  class:list={[
    "flex flex-col gap-0.5 rounded-[9px] border p-4",
    accent ? "border-accent/30 bg-accent-bg" : "border-line bg-surface",
  ]}
>
  <span class:list={["label", accent && "text-accent/80"]}>{label}</span>
  <span
    id={id}
    class:list={[
      "num text-[25px] leading-tight font-medium tracking-tight",
      accent && "text-accent",
    ]}>&nbsp;</span
  >
  <span
    id={footId}
    class:list={["text-[11.5px] text-muted", accent && "text-accent/80"]}
    >{foot}</span
  >
</div>
