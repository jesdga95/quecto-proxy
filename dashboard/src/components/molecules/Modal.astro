---
interface Props { id: string; labelledBy: string }
const { id, labelledBy } = Astro.props;
---

<div
  id={id}
  hidden
  class="fixed inset-0 z-50 grid place-items-center bg-black/40 p-6 max-md:p-3"
>
  <div
    role="dialog"
    aria-modal="true"
    aria-labelledby={labelledBy}
    class="max-h-[calc(100dvh-24px)] w-full max-w-[452px] overflow-y-auto rounded-[11px] border border-line bg-surface shadow-[0_16px_48px_-12px_rgba(0,0,0,0.28)]"
  >
    <slot />
  </div>
</div>
