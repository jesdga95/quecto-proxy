---
import Icon from "../atoms/Icon.astro";

interface Props { current: "overview" | "keys" | "logs" | "settings" }
const { current } = Astro.props;

const nav = [
  { id: "overview", href: "/admin/", label: "Overview", icon: "gauge" },
  { id: "keys", href: "/admin/keys", label: "API keys", icon: "key" },
  { id: "logs", href: "/admin/logs", label: "Logs", icon: "list-bullets" },
  { id: "settings", href: "/admin/settings", label: "Settings", icon: "sliders-horizontal" },
] as const;
---

<aside
  class="sticky top-0 flex h-screen flex-col border-r border-line bg-surface max-md:static max-md:h-auto"
>
  <div class="flex items-baseline gap-2 px-[18px] pt-5 pb-[18px]">
    <span class="font-mono text-[15px] font-semibold tracking-[0.08em]">QUECTO</span>
    <span class="font-mono text-[10px] tracking-[0.04em] text-muted">10⁻³⁰</span>
  </div>

  <nav class="flex flex-col gap-0.5 px-2.5" aria-label="Primary">
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.id ? "page" : undefined}
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2.5 py-[7px] text-[13.5px] transition-colors",
            current === item.id
              ? "bg-accent-bg font-medium text-accent"
              : "text-ink-2 hover:bg-surface-2 hover:text-ink",
          ]}
        >
          <Icon name={item.icon} class="size-[17px] shrink-0" />
          {item.label}
          {item.id === "keys" && (
            <span id="nav-key-count" class="num ml-auto text-[11px] text-muted" />
          )}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t border-line px-2.5 py-3 max-md:hidden">
    <div
      class="flex items-center gap-2 rounded-md border border-line bg-bg px-2.5 py-2"
    >
      <span id="upstream-dot" class="size-1.5 shrink-0 rounded-full bg-muted"></span>
      <div class="min-w-0">
        <div id="upstream-label" class="text-[11px] leading-snug text-muted">
          Checking upstream
        </div>
        <div
          id="upstream-host"
          class="truncate font-mono text-[11.5px] text-ink-2"
        >
        </div>
      </div>
    </div>
    <button
      id="sign-out"
      class="mt-1.5 flex w-full items-center gap-2.5 rounded-md px-2.5 py-[7px] text-left text-[13.5px] text-ink-2 hover:bg-surface-2 hover:text-ink"
    >
      <Icon name="sign-out" class="size-[17px] shrink-0" />
      Sign out
    </button>
  </div>
</aside>
