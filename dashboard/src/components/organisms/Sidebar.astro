---
import Icon from "../atoms/Icon.astro";
import Logo from "../atoms/Logo.astro";

interface Props { current: "overview" | "keys" | "logs" | "settings" }
const { current } = Astro.props;

const nav = [
  { id: "overview", href: "/admin/", label: "Overview", icon: "gauge" },
  { id: "keys", href: "/admin/keys", label: "API keys", icon: "key" },
  { id: "logs", href: "/admin/logs", label: "Logs", icon: "list-bullets" },
  { id: "settings", href: "/admin/settings", label: "Settings", icon: "sliders-horizontal" },
] as const;
---

<aside
  class="sticky top-0 z-30 flex h-screen flex-col border-r border-line bg-surface max-md:h-auto max-md:border-r-0 max-md:border-b"
>
  <div
    class="flex items-center gap-2.5 px-[18px] pt-[18px] pb-[18px] max-md:px-4 max-md:py-2.5"
  >
    <Logo size={30} />
    <span class="text-[10px] tracking-[0.06em] text-muted">10⁻³⁰</span>

    <!-- The footer below sits past the end of a phone page, so sign out travels
         with the brand instead. -->
    <button data-sign-out class="icon-btn -mr-1 ml-auto hidden max-md:grid" aria-label="Sign out">
      <Icon name="sign-out" class="size-[17px]" />
    </button>
  </div>

  <!-- On a phone the tabs leave the top of the page for the bottom edge, where a
       thumb already rests. Fixed to the viewport rather than the brand row, so
       they stay put as the page scrolls, and padded past the home indicator. -->
  <nav
    class="flex flex-col gap-0.5 px-2.5 max-md:fixed max-md:inset-x-0 max-md:bottom-0 max-md:z-40 max-md:flex-row max-md:gap-0 max-md:border-t max-md:border-line max-md:bg-surface max-md:px-1.5 max-md:pt-1.5 max-md:pb-[calc(6px_+_env(safe-area-inset-bottom,0px))]"
    aria-label="Primary"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.id ? "page" : undefined}
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2.5 py-[7px] text-[13.5px] transition-colors",
            "max-md:relative max-md:flex-1 max-md:flex-col max-md:justify-center max-md:gap-[3px] max-md:px-1 max-md:py-1.5 max-md:text-[10.5px] max-md:whitespace-nowrap",
            current === item.id
              ? // A filled pill spans a whole tab down here, which is heavier than
                // the selection deserves, so the tint carries it alone.
                "bg-accent-bg font-medium text-accent max-md:bg-transparent"
              : "text-ink-2 hover:bg-surface-2 hover:text-ink max-md:hover:bg-transparent",
          ]}
        >
          <Icon name={item.icon} class="size-[17px] shrink-0" />
          {item.label}
          {item.id === "keys" && (
            // A stacked tab has no room beside the label, so the count leaves the
            // flow and badges the icon instead.
            <span
              id="nav-key-count"
              class="num ml-auto text-[11px] text-muted max-md:absolute max-md:top-0.5 max-md:left-[calc(50%_+_7px)] max-md:ml-0 max-md:text-[9.5px]"
            />
          )}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t border-line px-2.5 py-3 max-md:hidden">
    <button
      data-sign-out
      class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-[7px] text-left text-[13.5px] text-ink-2 hover:bg-surface-2 hover:text-ink"
    >
      <Icon name="sign-out" class="size-[17px] shrink-0" />
      Sign out
    </button>
  </div>
</aside>
