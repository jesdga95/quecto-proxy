---
import Icon from "../atoms/Icon.astro";

interface Props { current: "overview" | "keys" | "logs" | "settings" }
const { current } = Astro.props;

const nav = [
  { id: "overview", href: "/admin/", label: "Overview", icon: "gauge" },
  { id: "keys", href: "/admin/keys", label: "API keys", icon: "key" },
  { id: "logs", href: "/admin/logs", label: "Logs", icon: "list-bullets" },
  { id: "settings", href: "/admin/settings", label: "Settings", icon: "sliders-horizontal" },
] as const;
---

<aside
  class="sticky top-0 z-30 flex h-screen flex-col border-r border-line bg-surface max-md:h-auto max-md:border-r-0 max-md:border-b"
>
  <div
    class="flex items-baseline gap-2 px-[18px] pt-5 pb-[18px] max-md:px-4 max-md:py-2.5"
  >
    <span class="font-mono text-[15px] font-semibold tracking-[0.08em]">QUECTO</span>
    <span class="font-mono text-[10px] tracking-[0.04em] text-muted">10⁻³⁰</span>

    <!-- The footer below sits past the end of a phone page, so sign out travels
         with the brand instead. -->
    <button data-sign-out class="icon-btn -mr-1 ml-auto hidden max-md:grid" aria-label="Sign out">
      <Icon name="sign-out" class="size-[17px]" />
    </button>
  </div>

  <nav
    class="flex flex-col gap-0.5 px-2.5 max-md:flex-row max-md:gap-1 max-md:overflow-x-auto max-md:px-3 max-md:pb-2.5"
    aria-label="Primary"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          aria-current={current === item.id ? "page" : undefined}
          class:list={[
            "flex items-center gap-2.5 rounded-md px-2.5 py-[7px] text-[13.5px] transition-colors max-md:shrink-0 max-md:gap-2 max-md:whitespace-nowrap",
            current === item.id
              ? "bg-accent-bg font-medium text-accent"
              : "text-ink-2 hover:bg-surface-2 hover:text-ink",
          ]}
        >
          <Icon name={item.icon} class="size-[17px] shrink-0" />
          {item.label}
          {item.id === "keys" && (
            <span id="nav-key-count" class="num ml-auto text-[11px] text-muted" />
          )}
        </a>
      ))
    }
  </nav>

  <div class="mt-auto border-t border-line px-2.5 py-3 max-md:hidden">
    <button
      data-sign-out
      class="flex w-full items-center gap-2.5 rounded-md px-2.5 py-[7px] text-left text-[13.5px] text-ink-2 hover:bg-surface-2 hover:text-ink"
    >
      <Icon name="sign-out" class="size-[17px] shrink-0" />
      Sign out
    </button>
  </div>
</aside>
