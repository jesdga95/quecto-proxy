---
import type { HTMLAttributes } from "astro/types";

// Anything else a button takes, data attributes included, passes straight
// through: callers reach for aria-label and data-close on these.
interface Props extends HTMLAttributes<"button"> {
  variant?: "primary" | "ghost";
  size?: "md" | "sm";
}

const {
  variant = "primary",
  size = "md",
  type = "button",
  class: cls = "",
  ...rest
} = Astro.props;
---

<button
  type={type}
  class:list={["btn", `btn-${variant}`, size === "sm" && "btn-sm", cls]}
  {...rest}
>
  <slot />
</button>
