---
import Dashboard from "../layouts/Dashboard.astro";
import Button from "../components/atoms/Button.astro";
---

<Dashboard title="Logs" current="logs">
  <div class="mb-[22px]">
    <h1 class="mb-[3px] text-xl font-medium tracking-[-0.011em]">Logs</h1>
    <p id="logs-sub" class="text-[13px] text-muted">
      Metadata only. Prompts and responses are never stored.
    </p>
  </div>

  <!-- Two filters to a row on a phone, rather than three squeezed into one. -->
  <div class="mb-3 flex flex-wrap gap-2">
    <select
      id="f-key"
      class="select w-auto min-w-[132px] max-md:min-w-0 max-md:flex-1 max-md:basis-[calc(50%-4px)]"
    >
      <option value="">All keys</option>
    </select>
    <select
      id="f-status"
      class="select w-auto min-w-[132px] max-md:min-w-0 max-md:flex-1 max-md:basis-[calc(50%-4px)]"
    >
      <option value="">All statuses</option>
      <option value="success">Success</option>
      <option value="rate_limited">Rate limited</option>
      <option value="client_error">Client errors</option>
      <option value="server_error">Server errors</option>
    </select>
    <select
      id="f-range"
      class="select w-auto min-w-[132px] max-md:min-w-0 max-md:flex-1 max-md:basis-[calc(50%-4px)]"
    >
      <option value="24">Last 24 hours</option>
      <option value="168">Last 7 days</option>
      <option value="720">Last 30 days</option>
      <option value="0">All time</option>
    </select>
  </div>

  <div class="card overflow-x-auto">
    <table>
      <thead>
        <tr>
          <th>Time</th>
          <th>Key</th>
          <th>Model</th>
          <th>Status</th>
          <th class="right">In</th>
          <th class="right">Cached</th>
          <th class="right">Out</th>
          <th class="right">TTFT</th>
          <th class="right">Duration</th>
        </tr>
      </thead>
      <tbody id="log-rows"></tbody>
    </table>
    <div id="logs-empty" hidden class="px-6 py-14 text-center">
      <p class="text-[13px] font-medium text-ink-2">Nothing here yet</p>
      <p class="mt-1 text-[12.5px] text-muted">
        Requests appear a moment after they are served.
      </p>
    </div>
  </div>

  <div class="mt-3 flex justify-center">
    <Button variant="ghost" size="sm" id="load-more" class="hidden">Load more</Button>
  </div>
</Dashboard>

<script>
  import { api, type LogEntry } from "../lib/api";
  import { clockTime, count, esc, millis, statusClass } from "../lib/format";

  const el = (id: string) => document.getElementById(id)!;
  let cursor: number | null = null;

  function row(e: LogEntry): string {
    const io = (n: number | null) => (n === null ? "" : count(n));
    return `<tr>
      <td class="num text-[11.5px] text-muted">${esc(clockTime(e.ts))}</td>
      <td>${esc(e.key_name || "Deleted key")}</td>
      <td>${e.model ? `<span class="mono-chip">${esc(e.model)}</span>` : ""}</td>
      <td><span class="code ${statusClass(e.status)}">${e.status}</span></td>
      <td class="right num">${io(e.prompt_tokens)}</td>
      <td class="right num">${io(e.cached_tokens)}</td>
      <td class="right num">${io(e.completion_tokens)}</td>
      <td class="right num">${esc(millis(e.ttft_ms))}</td>
      <td class="right num">${esc(millis(e.duration_ms))}</td>
    </tr>`;
  }

  function filters(): Record<string, string> {
    const hours = Number((el("f-range") as HTMLSelectElement).value);
    const params: Record<string, string> = {
      key_id: (el("f-key") as HTMLSelectElement).value,
      status: (el("f-status") as HTMLSelectElement).value,
      limit: "50",
    };
    if (hours > 0) {
      params.from = String(Math.floor(Date.now() / 1000) - hours * 3600);
    }
    if (cursor !== null) params.cursor = String(cursor);
    return params;
  }

  async function load(append = false) {
    if (!append) cursor = null;
    const res = await api.logs(filters());
    const rows = (res.logs ?? []).map(row).join("");

    if (append) {
      el("log-rows").insertAdjacentHTML("beforeend", rows);
    } else {
      el("log-rows").innerHTML = rows;
      el("logs-empty").hidden = (res.logs ?? []).length > 0;
    }

    cursor = res.next_cursor;
    el("load-more").classList.toggle("hidden", cursor === null);
  }

  for (const id of ["f-key", "f-status", "f-range"]) {
    el(id).addEventListener("change", () => load(false));
  }
  el("load-more").addEventListener("click", () => load(true));

  api.keys().then(({ keys }) => {
    const select = el("f-key") as HTMLSelectElement;
    for (const k of keys) {
      const opt = document.createElement("option");
      opt.value = String(k.id);
      opt.textContent = k.name;
      select.append(opt);
    }
  });

  api.health().then((h) => {
    if (h.logs_dropped > 0) {
      el("logs-sub").innerHTML =
        `Metadata only. Prompts and responses are never stored. <span class="text-warn">${count(h.logs_dropped)} records were dropped because the write buffer filled.</span>`;
    }
  });

  load();
</script>
