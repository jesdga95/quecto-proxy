---
import Dashboard from "../layouts/Dashboard.astro";
import Button from "../components/atoms/Button.astro";
import Icon from "../components/atoms/Icon.astro";
import Modal from "../components/molecules/Modal.astro";
import FormField from "../components/molecules/FormField.astro";
---

<Dashboard title="API keys" current="keys">
  <div class="mb-[22px] flex items-start justify-between gap-6">
    <div>
      <h1 class="mb-[3px] text-xl font-medium tracking-[-0.011em]">API keys</h1>
      <p class="text-[13px] text-muted">
        Each key carries its own expiration and rate limits. A key is shown in
        full only once, at creation.
      </p>
    </div>
    <Button id="open-create"><Icon name="plus" class="size-[15px]" />Create key</Button>
  </div>

  <div class="card overflow-x-auto">
    <table class="key-table">
      <!-- Every column is pinned, so the live cells cannot resize the table as
           they refresh and spare width spreads across all six in proportion
           rather than piling onto whichever one was left to absorb it. -->
      <colgroup>
        <col class="w-[206px]" />
        <col class="w-[146px]" />
        <col class="w-[228px]" />
        <col class="w-[156px]" />
        <col class="w-[140px]" />
        <col class="w-[166px]" />
      </colgroup>
      <thead>
        <tr>
          <th>Name</th>
          <th>Key</th>
          <th>Limits</th>
          <th>Status</th>
          <th>Activity</th>
          <th></th>
        </tr>
      </thead>
      <tbody id="key-rows"></tbody>
    </table>
    <div id="keys-empty" hidden class="px-6 py-14 text-center">
      <p class="text-[13px] font-medium text-ink-2">No keys yet</p>
      <p class="mt-1 text-[12.5px] text-muted">
        Create one to start sending traffic through Quecto.
      </p>
    </div>
  </div>

  <!-- Read by the row renderer, since rows are built after the build step that
       inlines these. -->
  <div hidden>
    <span id="icon-edit"><Icon name="pencil-simple" /></span>
    <span id="icon-rotate"><Icon name="arrows-clockwise" /></span>
    <span id="icon-revoke"><Icon name="prohibit" /></span>
    <span id="icon-delete"><Icon name="trash" /></span>
  </div>
</Dashboard>

<Modal id="create-modal" labelledBy="create-title">
  <div id="step-form">
    <div class="flex items-start justify-between gap-4 px-[18px] pt-[17px]">
      <div>
        <h2 id="create-title" class="text-[15px] font-medium">Create API key</h2>
        <p class="mt-[3px] text-[12.5px] text-muted">
          You will see the key once, right after it is created.
        </p>
      </div>
      <button class="icon-btn" data-close aria-label="Close">
        <Icon name="x" class="size-[15px]" />
      </button>
    </div>

    <div class="flex flex-col gap-3.5 p-[18px]">
      <FormField label="Name" for="k-name">
        <input class="input" id="k-name" placeholder="Laptop, n8n, phone" />
      </FormField>

      <FormField label="Expires" for="k-exp">
        <select class="select" id="k-exp">
          <option value="0">Never</option>
          <option value="7">In 7 days</option>
          <option value="30" selected>In 30 days</option>
          <option value="90">In 90 days</option>
          <option value="365">In a year</option>
        </select>
      </FormField>

      <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">
        <FormField label="Requests per minute" for="k-rpm">
          <input class="input num" id="k-rpm" inputmode="numeric" value="60" />
        </FormField>
        <FormField label="Tokens per minute" for="k-tpm">
          <input class="input num" id="k-tpm" inputmode="numeric" value="120000" />
        </FormField>
      </div>

      <FormField label="Total token limit" for="k-total">
        <input
          class="input num"
          id="k-total"
          inputmode="numeric"
          placeholder="No limit"
        />
      </FormField>

      <span class="text-[11.5px] text-muted">
        Leave a limit empty for no limit. A key that spends its total token
        limit stops working for good, until the limit is raised or reset.
      </span>
      <p id="create-error" hidden class="text-[12.5px] text-crit"></p>
    </div>

    <div
      class="flex justify-end gap-2 rounded-b-[11px] border-t border-line bg-surface-2 px-[18px] py-3"
    >
      <Button variant="ghost" data-close>Cancel</Button>
      <Button id="do-create">Create key</Button>
    </div>
  </div>

  <div id="step-done" hidden>
    <div class="px-[18px] pt-[17px]">
      <h2 id="done-title" class="text-[15px] font-medium">Key created</h2>
      <p class="mt-[3px] text-[12.5px] text-muted">
        Copy it now. Quecto stores only a hash.
      </p>
    </div>

    <div class="flex flex-col gap-3.5 p-[18px]">
      <div
        class="flex items-center gap-2.5 rounded-md border border-line-strong bg-surface-2 px-3 py-2.5"
      >
        <code id="new-key" class="flex-1 font-mono text-[12.5px] break-all"></code>
        <Button variant="ghost" size="sm" id="copy-key">
          <Icon name="copy" class="size-[15px]" /><span>Copy</span>
        </Button>
      </div>

      <div
        class="flex gap-2.5 rounded-md bg-warn-bg px-3 py-2.5 text-[12.5px] leading-relaxed text-warn"
      >
        <Icon name="warning-circle" class="mt-px size-4 shrink-0" />
        <span>
          This is the only time the key is shown. If you lose it, rotate the key to
          get a new one.
        </span>
      </div>

      <label class="flex items-center gap-2 text-[12.5px] text-ink-2">
        <input type="checkbox" id="ack" /> I have stored the key somewhere safe
      </label>
    </div>

    <div
      class="flex justify-end rounded-b-[11px] border-t border-line bg-surface-2 px-[18px] py-3"
    >
      <Button id="finish" disabled>Done</Button>
    </div>
  </div>
</Modal>

<Modal id="edit-modal" labelledBy="edit-title">
  <div class="flex items-start justify-between gap-4 px-[18px] pt-[17px]">
    <div>
      <h2 id="edit-title" class="text-[15px] font-medium">Edit API key</h2>
      <p id="edit-sub" class="mt-[3px] text-[12.5px] text-muted"></p>
    </div>
    <button class="icon-btn" data-close aria-label="Close">
      <Icon name="x" class="size-[15px]" />
    </button>
  </div>

  <div class="flex flex-col gap-3.5 p-[18px]">
    <FormField label="Name" for="e-name">
      <input class="input" id="e-name" placeholder="Laptop, n8n, phone" />
    </FormField>

    <FormField label="Expires" for="e-exp">
      <select class="select" id="e-exp">
        <option value="keep">Keep the current date</option>
        <option value="0">Never</option>
        <option value="7">In 7 days</option>
        <option value="30">In 30 days</option>
        <option value="90">In 90 days</option>
        <option value="365">In a year</option>
      </select>
    </FormField>

    <div class="grid grid-cols-2 gap-3 max-sm:grid-cols-1">
      <FormField label="Requests per minute" for="e-rpm">
        <input class="input num" id="e-rpm" inputmode="numeric" placeholder="No limit" />
      </FormField>
      <FormField label="Tokens per minute" for="e-tpm">
        <input class="input num" id="e-tpm" inputmode="numeric" placeholder="No limit" />
      </FormField>
    </div>

    <FormField
      label="Total token limit"
      for="e-total"
      hint="Setting one below what the key has already spent stops it at once."
    >
      <input
        class="input num"
        id="e-total"
        inputmode="numeric"
        placeholder="No limit"
      />
    </FormField>

    <label id="e-reset-row" class="flex items-start gap-2 text-[12.5px] text-ink-2">
      <input type="checkbox" id="e-reset" class="mt-[3px]" />
      <span>
        Restart its spent token count
        <span class="block text-[11.5px] text-muted">
          Brings a key that spent its quota back to work. Its logged usage is
          left alone.
        </span>
      </span>
    </label>

    <span class="text-[11.5px] text-muted">
      Leave a limit empty for no limit. Everything the key has spent, and the key
      itself, stay as they are.
    </span>
    <p id="edit-error" hidden class="text-[12.5px] text-crit"></p>
  </div>

  <div
    class="flex justify-end gap-2 rounded-b-[11px] border-t border-line bg-surface-2 px-[18px] py-3"
  >
    <Button variant="ghost" data-close>Cancel</Button>
    <Button id="do-edit">Save</Button>
  </div>
</Modal>

<script>
  import { api, type Key, type KeyPatch } from "../lib/api";
  import { ago, date, daysUntil, esc, count, tokensTight } from "../lib/format";

  const el = (id: string) => document.getElementById(id)!;
  const modal = el("create-modal");
  const editModal = el("edit-modal");
  const ICON = {
    edit: el("icon-edit").innerHTML,
    rotate: el("icon-rotate").innerHTML,
    revoke: el("icon-revoke").innerHTML,
    delete: el("icon-delete").innerHTML,
  };
  const STATUS = {
    active: "Active",
    revoked: "Revoked",
    expired: "Expired",
    exhausted: "Exhausted",
  };

  /** One lane per limit, reading what the key spent over the last minute against
   * what it is allowed. A burst bucket admits its burst plus a minute of refill,
   * so a spend above the limit is real and the lane clamps rather than the number.
   * The colour comes from the bucket, which is the thing that actually refuses.
   * The fill never drops below a sliver, so an idle lane still reads as a lane.
   *
   * The three stack rather than sitting side by side, so the same limit lands in
   * the same place on every row and a column of rpm can be read down the table. */
  function lane(
    used: number,
    exhausted: boolean,
    limit: number | null,
    unit: string,
    fmt: (n: number) => string,
    kind = "",
  ): string {
    let state = "is-off";
    let value = "∞";
    let pct = 2;

    if (limit !== null) {
      value = `${fmt(used)}/${fmt(limit)}`;
      pct = Math.max(2, Math.min(100, Math.round((used / limit) * 100)));
      state = exhausted ? "is-full" : used === 0 ? "is-idle" : "";
    }

    return `<div class="lane ${state} ${kind}">
      <span class="unit">${unit}</span>
      <div class="rail"><span style="width:${pct}%"></span></div>
      <span class="num">${value}</span>
    </div>`;
  }

  /** The quota lane gets an inset track rather than a rail, because it is the one
   * allowance that only empties: the other two refill within the minute. */
  function limitsCell(k: Key): string {
    return `<td class="lanes-cell">
      <span class="key-label">Limits</span>
      <div class="lanes">
        ${lane(k.live.rpm_used, k.live.rpm_exhausted, k.rpm_limit, "rpm", count)}
        ${lane(k.live.tpm_used, k.live.tpm_exhausted, k.tpm_limit, "tpm", tokensTight)}
        ${lane(k.live.total_spent, k.live.total_exhausted, k.total_token_limit, "total", tokensTight, "is-quota")}
      </div>
    </td>`;
  }

  /** Ranked, so being refused outranks lapsing when a key is doing both. The word
   * carries its own colour and nothing is drawn around it, so only what needs
   * attention is tinted and a healthy key stays quiet. It states the state and
   * stops there: what to do about it does not belong in a cell that refreshes. */
  function statusCell(k: Key): string {
    let tone = "text-muted";
    let label = "Active";

    if (k.status === "exhausted") {
      // A spent quota is a key that just died, not one retired on purpose.
      tone = "text-crit font-medium";
      label = "Exhausted";
    } else if (k.status !== "active") {
      label = STATUS[k.status];
    } else if (k.live.rpm_exhausted || k.live.tpm_exhausted) {
      tone = "text-crit font-medium";
      label = "Rate limited";
    } else if (k.expires_at && daysUntil(k.expires_at) <= 7) {
      tone = "text-warn font-medium";
      label = "Expires soon";
    }

    return `<td>
      <span class="key-label">Status</span>
      <div class="text-[12.5px] ${tone}">${label}</div>
    </td>`;
  }

  /** When it was last used, over when it lapses. The status column carries the
   * warning for a key that is about to, so the date itself stays quiet. */
  function activityCell(k: Key): string {
    const expires = k.expires_at ? esc(date(k.expires_at)) : "never";
    return `<td class="text-[12px]">
      <span class="key-label">Activity</span>
      <div class="text-ink-2">${esc(ago(k.last_used_at))}</div>
      <div class="text-[11.5px] text-muted">Expires ${expires}</div>
    </td>`;
  }

  /** Every key gets an editor, a retired one included: the name and the limits
   * are bookkeeping that stays meaningful once the key cannot serve traffic. */
  function actions(k: Key): string {
    const edit = `<button class="icon-btn icon-btn-outline" data-edit="${k.id}"
        title="Edit" aria-label="Edit ${esc(k.name)}">${ICON.edit}</button>`;
    const rotate =
      k.status === "revoked" || k.status === "expired"
        ? ""
        : `<button class="icon-btn icon-btn-outline" data-rotate="${k.id}"
             title="Rotate" aria-label="Rotate ${esc(k.name)}">${ICON.rotate}</button>`;
    const revoke =
      k.status !== "active"
        ? ""
        : `<button class="icon-btn icon-btn-outline" data-revoke="${k.id}"
             title="Revoke" aria-label="Revoke ${esc(k.name)}">${ICON.revoke}</button>`;
    return `<td class="key-actions right">
      <div class="flex justify-end gap-1.5">${edit}${rotate}${revoke}
        <button class="icon-btn icon-btn-outline icon-btn-danger" data-delete="${k.id}"
          title="Delete" aria-label="Delete ${esc(k.name)}">${ICON.delete}</button>
      </div>
    </td>`;
  }

  /** Retired keys step back. A spent quota does not: it is a key that just
   * stopped working rather than one taken out of service on purpose. */
  function row(k: Key): string {
    const retired = k.status === "revoked" || k.status === "expired";
    return `<tr class="${retired ? "opacity-60" : ""}" data-id="${k.id}">
      <td>
        <span
          class="block truncate font-medium"
          title="Created ${esc(date(k.created_at))}"
        >${esc(k.name)}</span>
      </td>
      <td>
        <span class="key-label">Key</span>
        <span class="mono-chip whitespace-nowrap">${esc(k.key_prefix)}</span>
      </td>
      ${limitsCell(k)}
      ${statusCell(k)}
      ${activityCell(k)}
      ${actions(k)}
    </tr>`;
  }

  /** What the last poll saw, so the edit button on a row can find the key behind
   * it without carrying every field through a data attribute. The 5 second
   * refresh replaces the rows and this with them. */
  let keysById = new Map<number, Key>();

  /** The key as it was when the dialog was filled, which is what a save is
   * diffed against. Held apart from the poll's map so a refresh while the dialog
   * is open cannot change what the person on screen is looking at. */
  let editingId = 0;
  let editingBase: Key | null = null;

  async function load() {
    const { keys } = await api.keys();
    keysById = new Map(keys.map((k) => [k.id, k]));
    el("keys-empty").hidden = keys.length > 0;
    el("key-rows").innerHTML = keys.map(row).join("");
  }

  el("key-rows").addEventListener("click", async (e) => {
    const target = (e.target as HTMLElement).closest("button");
    if (!target) return;

    const edit = target.dataset.edit;
    const rotate = target.dataset.rotate;
    const revoke = target.dataset.revoke;
    const remove = target.dataset.delete;

    if (edit) {
      const k = keysById.get(Number(edit));
      if (k) openEdit(k);
      return;
    }

    if (rotate) {
      if (!confirm("Rotate this key? The current key stops working immediately. Limits and usage stay.")) return;
      try {
        const rotated = await api.rotateKey(Number(rotate));
        showSecret(rotated.secret, "Key rotated");
      } catch (e) {
        alert(e instanceof Error ? e.message : "Could not rotate the key.");
        load();
      }
    }

    if (revoke) {
      if (!confirm("Revoke this key? Anything using it stops working immediately.")) return;
      await api.revokeKey(Number(revoke));
      load();
    }
    if (remove) {
      if (!confirm("Delete this key permanently? Its past usage stays in the totals as a deleted key.")) return;
      await api.deleteKey(Number(remove));
      load();
    }
  });

  function showSecret(secret: string, title: string) {
    el("done-title").textContent = title;
    el("new-key").textContent = secret;
    (el("ack") as HTMLInputElement).checked = false;
    (el("finish") as HTMLButtonElement).disabled = true;
    el("step-form").hidden = true;
    el("step-done").hidden = false;
    modal.hidden = false;
  }

  function openModal() {
    modal.hidden = false;
    el("step-form").hidden = false;
    el("step-done").hidden = true;
    el("create-error").hidden = true;
    (el("ack") as HTMLInputElement).checked = false;
    (el("finish") as HTMLButtonElement).disabled = true;
    (el("k-name") as HTMLInputElement).value = "";
    // Cleared rather than left behind, so a quota typed and then abandoned does
    // not quietly attach itself to the next key.
    (el("k-total") as HTMLInputElement).value = "";
    (el("k-name") as HTMLInputElement).focus();
  }

  function closeModal() {
    modal.hidden = true;
    load();
  }

  /** Prefilled rather than blank, since the dialog edits what is already set and
   * a field left empty means taking that limit away. */
  function openEdit(k: Key) {
    editingId = k.id;
    editingBase = k;
    (el("edit-sub") as HTMLElement).textContent = k.key_prefix;
    (el("e-name") as HTMLInputElement).value = k.name;
    (el("e-rpm") as HTMLInputElement).value = k.rpm_limit === null ? "" : String(k.rpm_limit);
    (el("e-tpm") as HTMLInputElement).value = k.tpm_limit === null ? "" : String(k.tpm_limit);
    (el("e-total") as HTMLInputElement).value =
      k.total_token_limit === null ? "" : String(k.total_token_limit);

    // The create dialog can only offer dates from today, so the one already on
    // the key is shown as itself and staying put means sending nothing.
    const keep = el("e-exp").querySelector("option[value='keep']")!;
    keep.textContent =
      k.expires_at === null
        ? "Never"
        : daysUntil(k.expires_at) < 0
          ? `Keep ${date(k.expires_at)}, expired`
          : `Keep ${date(k.expires_at)}`;
    (el("e-exp") as HTMLSelectElement).value = "keep";

    el("e-reset-row").hidden = k.total_token_limit === null;
    (el("e-reset") as HTMLInputElement).checked = false;
    el("edit-error").hidden = true;
    editModal.hidden = false;
    (el("e-name") as HTMLInputElement).focus();
  }

  function closeEdit() {
    editModal.hidden = true;
    load();
  }

  el("open-create").addEventListener("click", openModal);

  /** Only the close and cancel controls dismiss the dialog. A click that lands
      on the backdrop is usually a selection that drifted out of a field. */
  modal.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-close]")) closeModal();
  });
  editModal.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-close]")) closeEdit();
  });

  // Escape backs out of the form only. Once the key is on screen it is shown
  // for the last time, so leaving takes the acknowledged Done button.
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    if (!editModal.hidden) closeEdit();
    else if (!modal.hidden && !el("step-form").hidden) closeModal();
  });

  /** Empty means no limit. Anything else that is not a whole number of at least
   * one is refused here rather than sent, so a stray letter cannot quietly take a
   * limit away, and the wording is the server's own from validLimits. */
  function limitField(
    id: string,
    msg: string,
  ): { ok: true; value: number | null } | { ok: false; msg: string } {
    const raw = (el(id) as HTMLInputElement).value.replace(/[,_\s]/g, "").trim();
    if (raw === "") return { ok: true, value: null };
    const n = Number(raw);
    return Number.isSafeInteger(n) && n >= 1
      ? { ok: true, value: n }
      : { ok: false, msg };
  }

  function limitValue(id: string): number | null {
    const raw = (el(id) as HTMLInputElement).value.replace(/[,_\s]/g, "").trim();
    if (raw === "") return null;
    const n = Number(raw);
    return Number.isFinite(n) && n > 0 ? n : null;
  }

  el("do-create").addEventListener("click", async () => {
    const btn = el("do-create") as HTMLButtonElement;
    const err = el("create-error");
    err.hidden = true;
    btn.disabled = true;

    const days = Number((el("k-exp") as HTMLSelectElement).value);
    try {
      const created = await api.createKey({
        name: (el("k-name") as HTMLInputElement).value,
        expires_at: days === 0 ? null : Math.floor(Date.now() / 1000) + days * 86400,
        rpm_limit: limitValue("k-rpm"),
        tpm_limit: limitValue("k-tpm"),
        total_token_limit: limitValue("k-total"),
      });
      showSecret(created.secret, "Key created");
    } catch (e) {
      err.textContent = e instanceof Error ? e.message : "Could not create the key.";
      err.hidden = false;
    } finally {
      btn.disabled = false;
    }
  });

  el("do-edit").addEventListener("click", async () => {
    const btn = el("do-edit") as HTMLButtonElement;
    const err = el("edit-error");
    const was = editingBase;
    if (!was) {
      closeEdit();
      return;
    }
    err.hidden = true;

    const rpm = limitField("e-rpm", "Requests per minute must be at least 1, or left empty for no limit.");
    if (!rpm.ok) return refuseEdit(err, rpm.msg);
    const tpm = limitField("e-tpm", "Tokens per minute must be at least 1, or left empty for no limit.");
    if (!tpm.ok) return refuseEdit(err, tpm.msg);
    const total = limitField("e-total", "The total token limit must be at least 1, or left empty for no limit.");
    if (!total.ok) return refuseEdit(err, total.msg);

    // Only what differs is sent, so a dialog saved unchanged cannot overwrite a
    // limit another tab moved while it was open.
    const patch: KeyPatch = { name: (el("e-name") as HTMLInputElement).value };
    if (rpm.value !== was.rpm_limit) {
      if (rpm.value === null) patch.clear_rpm_limit = true;
      else patch.rpm_limit = rpm.value;
    }
    if (tpm.value !== was.tpm_limit) {
      if (tpm.value === null) patch.clear_tpm_limit = true;
      else patch.tpm_limit = tpm.value;
    }
    if (total.value !== was.total_token_limit) {
      if (total.value === null) patch.clear_total_token_limit = true;
      else patch.total_token_limit = total.value;
    }

    const days = (el("e-exp") as HTMLSelectElement).value;
    if (days === "0") {
      if (was.expires_at !== null) patch.clear_expiry = true;
    } else if (days !== "keep") {
      patch.expires_at = Math.floor(Date.now() / 1000) + Number(days) * 86400;
    }
    if ((el("e-reset") as HTMLInputElement).checked) patch.reset_tokens_spent = true;

    btn.disabled = true;
    try {
      await api.updateKey(editingId, patch);
      closeEdit();
    } catch (e) {
      refuseEdit(err, e instanceof Error ? e.message : "Could not save the key.");
    } finally {
      btn.disabled = false;
    }
  });

  /** Shows a refusal in the dialog and leaves it open, so what was typed is not
   * lost to a closed form. */
  function refuseEdit(err: HTMLElement, msg: string): void {
    err.textContent = msg;
    err.hidden = false;
  }

  el("ack").addEventListener("change", (e) => {
    (el("finish") as HTMLButtonElement).disabled = !(e.target as HTMLInputElement).checked;
  });
  el("finish").addEventListener("click", closeModal);

  el("copy-key").addEventListener("click", async () => {
    const label = el("copy-key").querySelector("span")!;
    try {
      await navigator.clipboard.writeText(el("new-key").textContent ?? "");
      label.textContent = "Copied";
    } catch {
      label.textContent = "Press Ctrl C";
    }
    setTimeout(() => (label.textContent = "Copy"), 1600);
  });

  load();
  setInterval(load, 5000);
</script>
